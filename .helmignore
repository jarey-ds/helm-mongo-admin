# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# Exclude development/testing directories
mongo-express-1766-openid-connect-arg/
find-postgresql-service.sh
keycloak-values.yaml
# Exclude large files that aren't needed for the chart
*.md
LICENSE
# Keep only essential chart files
# templates/ - keep
# values.yaml - keep
# Chart.yaml - keep




